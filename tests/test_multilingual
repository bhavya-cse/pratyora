"""
Pratyora — Tests for multilingual analysis (language detection + translation).
Translation tests monkeypatch the network call so they run offline.
"""

import pytest
from services import text_analyzer as ta_module
from services.language_utils import detect_language
from services.text_analyzer import TextAnalyzer


HINDI_TEXT = (
    "भारतीय रिज़र्व बैंक ने आज घोषणा की कि मौद्रिक नीति समीक्षा बैठक के बाद "
    "प्रमुख ब्याज दरों को स्थिर रखा जाएगा और मुद्रास्फीति पर नजर रखी जाएगी।"
)


def test_unicode_validation_accepts_non_latin_scripts():
    analyzer = TextAnalyzer.get_instance()
    is_valid, err = analyzer.validate_input(HINDI_TEXT)
    assert is_valid is True
    assert err is None


def test_symbols_still_rejected():
    analyzer = TextAnalyzer.get_instance()
    is_valid, err = analyzer.validate_input("$$$$$ 1234567890 ++++ ---- !!!!!")
    assert is_valid is False
    assert "readable words" in err.lower()


def test_detect_hindi():
    lang, conf = detect_language(HINDI_TEXT)
    assert lang == "hi"
    assert conf > 0.8


def test_non_english_is_translated_before_analysis(monkeypatch):
    analyzer = TextAnalyzer.get_instance()
    if not analyzer.is_available():
        pytest.skip("Model not available")

    english = (
        "The Reserve Bank of India announced today that benchmark interest rates will remain "
        "stable following its monetary policy review meeting, while officials said they will "
        "continue to monitor inflation and economic growth indicators closely in the coming months."
    )
    monkeypatch.setattr(
        ta_module, "translate_to_english", lambda text, lang: (True, english, None)
    )

    result = analyzer.analyze(HINDI_TEXT)
    assert result["success"] is True
    assert result["detected_language"] == "hi"
    assert result["translated"] is True
    assert result["translation_note"]
    assert result["confidence"] != "High"


def test_translation_failure_is_reported(monkeypatch):
    analyzer = TextAnalyzer.get_instance()
    if not analyzer.is_available():
        pytest.skip("Model not available")

    monkeypatch.setattr(
        ta_module, "translate_to_english", lambda text, lang: (False, "", "network down")
    )
    result = analyzer.analyze(HINDI_TEXT)
    assert result["success"] is False
    assert result["error_code"] == "TRANSLATION_FAILED"


def test_english_is_not_translated():
    analyzer = TextAnalyzer.get_instance()
    if not analyzer.is_available():
        pytest.skip("Model not available")

    text = (
        "WASHINGTON (Reuters) - The Federal Reserve decided to hold interest rates steady "
        "following its monetary policy review on Wednesday, citing balanced employment metrics."
    )
    result = analyzer.analyze(text)
    assert result["success"] is True
    assert result["translated"] is False