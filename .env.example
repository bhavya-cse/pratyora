git add .env.example
# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=your-secure-random-secret-key-change-in-production
PORT=5001

# Application Limits
MAX_CONTENT_LENGTH=104857600  # 100 MB max request body
MAX_TEXT_LENGTH=20000         # 20,000 characters
MAX_IMAGE_SIZE_MB=5          # 5 MB
MAX_VIDEO_SIZE_MB=100        # 100 MB
MAX_VIDEO_DURATION_SECONDS=300 # 5 minutes maximum
VIDEO_FRAME_SAMPLE_INTERVAL=3  # Sample 1 frame every 3 seconds
VIDEO_MAX_FRAMES=60           # Maximum frames to inspect with OCR

# Binary Tool Paths (Leave empty for automatic system detection)
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
# FFMPEG_CMD=/opt/homebrew/bin/ffmpeg

# Speech-to-Text Configuration
# Supported providers: "google" (free web service via SpeechRecognition), "whisper" (local if installed), "external", "mock"
STT_PROVIDER=google
STT_EXTERNAL_API_KEY=
STT_EXTERNAL_ENDPOINT=
EXTERNAL_STT_CONSENT_REQUIRED=true
# Tesseract language packs for OCR, joined with '+' (only installed packs are used)
OCR_LANGS=eng+hin+kan+tam+tel+mal+mar+ben+guj+pan+urd

# Speech-to-text: 'whisper' auto-detects the spoken language (pip install openai-whisper)
# 'google' needs STT_LANGUAGE, e.g. en-US, hi-IN, kn-IN, ta-IN, te-IN
STT_PROVIDER=whisper
STT_LANGUAGE=en-US
WHISPER_MODEL=base

